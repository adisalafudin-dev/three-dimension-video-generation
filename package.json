{
  "name": "script-to-video",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@remotion/captions": "4.0.541",
    "@remotion/cli": "4.0.541",
    "@remotion/fonts": "4.0.541",
    "@remotion/media": "4.0.541",
    "@remotion/three": "4.0.541",
    "@remotion/transitions": "4.0.541",
    "gray-matter": "^4.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.541",
    "three": "^0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@remotion/eslint-config-flat": "4.0.541",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/three": "^0.187.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "msedge-tts": "^2.1.1",
    "prettier": "3.8.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:test": "remotion render src/index.ts TestModel out/test.mp4 --gl=angle",
    "parse": "tsx scripts/parse-script.ts storyboard/demo.md src/generated/storyboard.json",
    "dev": "npm run parse && remotion studio",
    "render": "npm run parse && remotion render src/index.ts ScriptVideo out/video.mp4 --gl=angle",
    "narrate": "tsx scripts/narrate.ts",
    "dev:vertical": "tsx scripts/parse-script.ts storyboard/rainbow-vertical.md src/generated/storyboard.json && remotion studio",
    "render:vertical": "tsx scripts/parse-script.ts storyboard/rainbow-vertical.md src/generated/storyboard.json && remotion render src/index.ts ScriptVideo out/vertical.mp4 --gl=angle"
  },
  "allowScripts": {
    "esbuild": false
  }
}
